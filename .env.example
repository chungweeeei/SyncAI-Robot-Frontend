# Copy to .env and edit. docker compose reads .env for the ${...} values in
# docker-compose.yaml; nothing else in the repo reads it (npm run dev does not).

# ---- image ----------------------------------------------------------------
# What `docker compose build frontend-build` tags and `frontend` runs.
# To pull the published image instead of building (see release.yml):
#   FRONTEND_IMAGE=ghcr.io/chungweeeei/syncai-robot-frontend
#   FRONTEND_TAG=1.2.0        # a release, or `main` for the release branch
# then `docker compose pull frontend && docker compose up -d frontend`.
FRONTEND_IMAGE=syncai-frontend
FRONTEND_TAG=local

# ---- run ------------------------------------------------------------------
# Host port the console is served on. Keep 3001 unless something else already
# owns it: the backend is on 3000, and package.json's dev/start use 3001 too.
FRONTEND_PORT=3001
TZ=Asia/Taipei

# ---- build ----------------------------------------------------------------
# Where the browser finds the backend. BUILD-TIME values: Next.js inlines
# NEXT_PUBLIC_* into the bundle, so changing them means rebuilding the image,
# not restarting the container.
#
# Leave both empty when the console and the backend run on the same machine
# (the normal case, including on the robot): the page then calls port 3000 of
# whatever host it was opened from, so http://<robot-ip>:3001 just works.
# Set them only when the backend lives somewhere else, e.g.
#   NEXT_PUBLIC_API_BASE=http://10.8.140.138:3000
#   NEXT_PUBLIC_WS_BASE=ws://10.8.140.138:3000
# No trailing slash. WS_BASE may stay empty; it is derived from API_BASE.
NEXT_PUBLIC_API_BASE=
NEXT_PUBLIC_WS_BASE=
